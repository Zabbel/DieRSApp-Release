<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Main App Theme -->
    <!-- Umgestellt auf Theme.AppCompat, damit Biometrie unter Android 8 nicht abstürzt -->
    <style name="Theme.DieRSApp" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/rs_blau</item>
        <item name="android:windowBackground">@color/white</item>
        <!-- Wir setzen die primären Farben auch im XML, falls System-Dialoge sie nutzen -->
        <item name="colorPrimary">@color/rs_blau</item>
        <item name="colorPrimaryDark">@color/rs_blau</item>
        <item name="colorAccent">@color/rs_blau</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.DieRSApp</item>
    </style>
</resources>
